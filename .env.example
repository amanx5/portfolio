# Copy to .env.local and adjust.
# Write values without quotes, so they can be pasted as-is into the Vercel dashboard,
# which takes values literally (quotes would become part of the value).

# Vercel AI Gateway key
AI_GATEWAY_API_KEY=your-key-here

# Vercel AI Gateway model id
# https://vercel.com/ai-gateway/models
MODEL_ID=nvidia/nemotron-3.5-lightning-free

# The published profile, in @promptfolio/core's profile format. Fetched at build time, then
# refreshed in the background at most once an hour.
PROFILE_URL=https://example.com/profile.json

# Public URL of the site, used for link previews (og:url). Optional: on Vercel the production
# domain is used automatically. Set it to override that, e.g. for a preview or another host.
SITE_URL=https://chat.example.com

# Your main site, which hosts the icons this site shares (favicon.ico, icon.png, apple-touch-icon.png
# at its root). No trailing slash. Leave unset to show no icon.
MAIN_SITE_URL=https://example.com

# Set to 1 to skip chat turn limits in development environment. Ignored when NODE_ENV is production.
DISABLE_CHAT_LIMIT=0

# GitHub token for the profile's GitHub data. Optional: without it, pinned repositories are
# skipped, at most 12 repositories are kept, and GitHub allows fewer requests.
# A fine-grained token with no extra permissions is enough (public data only).
GITHUB_TOKEN=

# REDIS
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Command to generate secret: openssl rand -base64 32
VISITOR_HASH_SECRET=<new secret>
